# 이어봄 환경변수 — `cp .env.example .env` 후 값을 채운다.
# 전체 목록·설명은 Notion 레이어 7 §7.3을 정본으로 한다.

# ==================== Common ====================
NODE_ENV=development

# ==================== Database ====================
# docker-compose.yml의 postgres 서비스 기준값 그대로다.
DATABASE_URL=postgresql://eobom:eobom_password@localhost:5432/eobom_db

# ==================== API (NestJS) ====================
API_PORT=3001
# CORS 허용 오리진. 미설정 시 http://localhost:3000 으로 폴백한다.
WEB_URL=http://localhost:3000

# 운영에서는 반드시 교체할 것.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 레이트 리밋. 정확히 'false'일 때만 꺼진다(그 외 값·미설정은 켜짐).
# 리밋 수치 자체는 apps/api/src/common/throttle/throttle.policy.ts의 상수다 —
# @Throttle 데코레이터가 .env 로드보다 먼저 평가돼 환경변수로는 조정할 수 없다.
# e2e는 playwright.config.ts가 자동으로 꺼 준다.
THROTTLE_ENABLED=true

# 프록시·로드밸런서 뒤에 배포할 때만 설정한다. 신뢰할 홉 수(예: 1).
# 미설정이면 Express가 req.ip를 그대로 쓴다(로컬 기본값).
# 설정하지 않고 프록시 뒤에 두면 레이트 리밋이 모든 사용자를 한 버킷에 넣는다.
# TRUST_PROXY=1

# ==================== Web (Next.js) ====================
WEB_PORT=3000
# 브라우저에서 호출하는 주소라 NEXT_PUBLIC_ 접두사가 필요하다.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ==================== Email (회원가입 인증코드) ====================
# 로컬은 mailpit 권장: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# SMTP_USER/PASS를 빈 값으로 두면 nodemailer가 AUTH PLAIN을 시도하다
# 'Missing credentials'로 실패한다 — mailpit은 아무 값이나 받으므로 채워 둔다.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
EMAIL_FROM=noreply@eobom.local

# ==================== Ollama (세션 리포트 생성) ====================
# 안 떠 있으면 리포트 생성이 503을 반환한다. 화면 자체는 정상 동작한다.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ==================== e2e ====================
# 테스트 DB. 미설정 시 아래 값으로 폴백한다(docker-compose.test.yml, 포트 5434).
# E2E_DATABASE_URL=postgresql://eobom:eobom_password@localhost:5434/eobom_test
